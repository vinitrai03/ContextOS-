# ContextOS Environment Configuration

# APP DEMO MODE (Set to true to run offline with seeded data & canned AI responses)
APP_DEMO_MODE=true
VITE_DEMO_MODE=true

# Server Configuration
PORT=8080
VITE_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api

# Database Configuration (PostgreSQL + pgvector)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/contextos
SPRING_DATASOURCE_USERNAME=contextos
SPRING_DATASOURCE_PASSWORD=contextos_secret_password

# Redis Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# JWT Security Configuration
JWT_SECRET=super_secret_jwt_signing_key_contextos_capstone_2026_minimum_256_bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Service Configuration (Optional if APP_DEMO_MODE=true)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
